{
  "rules": {
    // Matches: anyone may read (output displays, LED boards); only admins and
    // accounts whose org lists the channel in orgs/<org>/channels may write.
    "$node": {
      ".read": "$node.matches(/^match-[0-9]+$/)",
      ".write": "$node.matches(/^match-[0-9]+$/) && auth != null && (root.child('accounts/' + auth.uid + '/role').val() === 'admin' || root.child('orgs/' + root.child('accounts/' + auth.uid + '/org').val() + '/channels/' + $node.replace('match-', '')).exists())"
    },

    // Org name and channel -> court mapping, public for ?org=&court= links.
    "orgs": {
      ".read": true
    },

    // Org and role ("operator" | "admin") per account - readable by the
    // account itself, the full list by admins.
    "accounts": {
      ".read": "auth != null && root.child('accounts/' + auth.uid + '/role').val() === 'admin'",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },

    // Playerzone games currently loaded onto a court (read by the PZ for its
    // live view): live_games/<game_id> = { channel, main_game_id, org, court, since }.
    // Written like the match itself - the channel being replaced (data) and the
    // one written (newData) both have to be the account's, so nobody can take
    // over another org's entry or point an entry at a foreign court.
    "live_games": {
      ".read": true,
      "$gameId": {
        ".write": "auth != null && (root.child('accounts/' + auth.uid + '/role').val() === 'admin' || ((!data.exists() || root.child('orgs/' + root.child('accounts/' + auth.uid + '/org').val() + '/channels/' + data.child('channel').val()).exists()) && (!newData.exists() || root.child('orgs/' + root.child('accounts/' + auth.uid + '/org').val() + '/channels/' + newData.child('channel').val()).exists())))",
        ".validate": "$gameId.matches(/^[0-9]+$/) && newData.hasChildren(['channel', 'since'])",
        "channel": { ".validate": "newData.isNumber()" },
        "since": { ".validate": "newData.isNumber()" },
        "main_game_id": { ".validate": "newData.isNumber()" },
        "org": { ".validate": "newData.isString()" },
        "court": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },

    // Config for the Fwango/Playerzone bridge: publicly readable, admins write.
    "bridgeConfig": {
      ".read": true,
      ".write": "auth != null && root.child('accounts/' + auth.uid + '/role').val() === 'admin'"
    }

    // Everything else (writing orgs and accounts) is locked and maintained
    // in the Firebase Console.
  }
}
